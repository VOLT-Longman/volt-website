{
  "name": "volt-website",
  "private": true,
  "scripts": {
    "serve": "node scripts/dev-server.js",
    "test": "playwright test",
    "lint": "biome lint .",
    "check:links": "node scripts/check-links.mjs",
    "check": "node scripts/check-syntax.mjs && node scripts/check-links.mjs && node scripts/check-migrations.mjs && node scripts/check-inner-html.mjs && node scripts/font/verify-volt-orbit.mjs && biome lint .",
    "test:functions": "node --test \"tests/functions/**/*.test.mjs\"",
    "cache-version": "node scripts/update-cache-version.js",
    "font:build": "node scripts/font/generate-volt-orbit-v3.mjs",
    "font:check": "node scripts/font/verify-volt-orbit.mjs",
    "shipdb:erkul:fetch": "node scripts/erkul/fetch-erkul-live.mjs",
    "shipdb:erkul:inspect": "node scripts/erkul/inspect-erkul-ship.mjs asgard",
    "shipdb:erkul:normalize": "node scripts/erkul/normalize-erkul-ships.mjs",
    "shipdb:erkul:market": "node scripts/erkul/normalize-erkul-market.mjs",
    "shipdb:erkul:match": "node scripts/erkul/match-erkul-to-volt.mjs",
    "shipdb:erkul:build-live": "node scripts/erkul/build-ship-live-data.mjs",
    "shipdb:erkul:apply": "node scripts/erkul/apply-erkul-live-data.mjs",
    "shipdb:erkul:translate-descriptions": "node scripts/erkul/apply-ship-description-ko.mjs",
    "shipdb:erkul:post-apply": "npm run shipdb:erkul:translate-descriptions && npm run check",
    "shipdb:erkul:classify-candidates": "node scripts/erkul/classify-new-ship-candidates.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@biomejs/biome": "^2.5.0",
    "@playwright/test": "^1.56.1"
  }
}
