{
  "name": "volt-website",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-server.js",
    "serve": "node scripts/dev-server.js",
    "test": "playwright test",
    "lint": "biome lint .",
    "check:links": "node scripts/check-links.mjs",
    "check": "node scripts/gear/check-private-models.mjs && node scripts/sync-motion-vendor.mjs --verify && node scripts/vendor-three.mjs --verify && node scripts/check-syntax.mjs && node scripts/check-links.mjs && node scripts/check-migrations.mjs && node scripts/check-inner-html.mjs && node scripts/build-ship-imagery.mjs --verify && node scripts/check-i18n.mjs && biome lint --error-on-warnings .",
    "test:functions": "node --test \"tests/functions/**/*.test.mjs\"",
    "cache-version": "node scripts/update-cache-version.js",
    "shipdb:canonical:manifest": "node scripts/shipdb-rewrite/build-canonical-manifest.mjs",
    "shipdb:canonical:build": "node scripts/shipdb-rewrite/build-canonical.mjs",
    "shipdb:imagery:build": "node scripts/build-ship-imagery.mjs",
    "loadout:build": "node scripts/loadout/build-loadout-data.mjs",
    "loadout:ko": "node scripts/loadout/build-loadout-ko.mjs",
    "motion:vendor": "node scripts/sync-motion-vendor.mjs",
    "three:vendor": "node scripts/vendor-three.mjs",
    "gear:models:check": "node scripts/gear/upload-models.mjs",
    "gear:models:upload": "node scripts/gear/upload-models.mjs --upload",
    "gear:models:verify": "node scripts/gear/upload-models.mjs --verify",
    "shipdb:sources:refresh": "node scripts/shipdb-rewrite/fetch-ship-sources.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1171.0",
    "@axe-core/playwright": "^4.11.3",
    "@biomejs/biome": "^2.5.0",
    "@playwright/test": "^1.56.1",
    "gsap": "3.15.1",
    "three": "0.187.0"
  }
}
